# Copie este arquivo para .env e preencha com suas credenciais locais.
# NUNCA commite o arquivo .env real no Git.

# --- Supabase (Fonte Única da Verdade) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_publica_anon_ou_publishable
# Usada apenas no backend / Python ETL / GitHub Actions Secrets (NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua_chave_secreta_service_role

# --- Notificações por E-mail (Opcional — Gmail SMTP / IMAP) ---
EMAIL_ADDRESS=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app_de_16_digitos

# --- Alertas Críticos do Pipeline ETL (Opcional — Discord / Slack Webhook) ---
ALERT_WEBHOOK_URL=
